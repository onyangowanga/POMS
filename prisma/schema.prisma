// POMS (Printers Operations Management System) — Prisma schema
// Multi-tenant SaaS schema for commercial digital print shops.
// Every business table carries a tenantId so rows are fully isolated per tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// TENANCY & IDENTITY
// ---------------------------------------------------------------------------

model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  jobPrefix    String // e.g. "ALU" -> job numbers become POMS-ALU-1001
  location     String?
  contactPhone String?
  contactEmail String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users             User[]
  clients           Client[]
  paperTypes        PaperType[]
  finishingServices FinishingService[]
  inventoryItems    InventoryItem[]
  stockMovements    StockMovement[]
  jobOrders         JobOrder[]
  transactions      Transaction[]
  purchases         Purchase[]
  expenses          Expense[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  jobOrderCounter   JobOrderCounter?

  @@map("tenants")
}

enum UserRole {
  OWNER
  ADMIN
  ACCOUNTANT
  PRODUCTION
  WORKER
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  passwordHash String
  role         UserRole @default(WORKER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobOrdersCreated  JobOrder[]      @relation("JobOrderCreatedBy")
  jobOrdersAssigned JobOrder[]      @relation("JobOrderAssignedTo")
  transactions      Transaction[]   @relation("TransactionRecordedBy")
  purchases         Purchase[]      @relation("PurchaseRecordedBy")
  expenses          Expense[]       @relation("ExpenseRecordedBy")
  stockMovements    StockMovement[] @relation("StockMovementCreatedBy")
  activityLogs      ActivityLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// CLIENTS
// ---------------------------------------------------------------------------

model Client {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  address       String?
  whatsappOptIn Boolean  @default(true)
  creditBalance Decimal  @default(0) @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  jobOrders     JobOrder[]
  transactions  Transaction[]
  notifications Notification[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// PRICE MATRIX (papers, finishing services)
// ---------------------------------------------------------------------------

enum PricingUnit {
  PER_SHEET
  PER_SQFT
  PER_ITEM
}

model PaperType {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String // e.g. "Art Paper 130 GSM"
  category         String? // e.g. "Art Paper", "Bond", "Card", "Sticker"
  gsm              Int?
  unit             PricingUnit @default(PER_SHEET)
  singleSidePrice  Decimal     @db.Decimal(10, 2)
  doubleSidePrice  Decimal?    @db.Decimal(10, 2) // null when double-side not offered (e.g. Sticker)
  sortOrder        Int         @default(0)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  inventoryItems InventoryItem[]
  orderItems     OrderItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("paper_types")
}

model FinishingService {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String // e.g. "Lamination", "Binding", "Folding"
  unit            PricingUnit @default(PER_ITEM)
  price           Decimal     @db.Decimal(10, 2) // single-side / standard price
  doubleSidePrice Decimal?    @db.Decimal(10, 2) // null when the service has no double-side tier
  sortOrder       Int         @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems OrderItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("finishing_services")
}

// ---------------------------------------------------------------------------
// INVENTORY / CONSUMABLES
// ---------------------------------------------------------------------------

enum InventoryType {
  PAPER
  TONER
  INK
  OTHER
}

model InventoryItem {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  type          InventoryType @default(OTHER)
  unit          String // e.g. "ream", "sheet", "cartridge"
  quantityOnHand Decimal      @default(0) @db.Decimal(12, 2)
  reorderLevel  Decimal       @default(0) @db.Decimal(12, 2)
  costPerUnit   Decimal       @default(0) @db.Decimal(10, 2)
  paperTypeId   String? // links a stock item to the price-list paper it supplies
  paperType     PaperType?    @relation(fields: [paperTypeId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stockMovements StockMovement[]

  @@index([tenantId])
  @@map("inventory_items")
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model StockMovement {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  type            StockMovementType
  quantity        Decimal           @db.Decimal(12, 2)
  reason          String?
  jobOrderId      String?
  jobOrder        JobOrder?         @relation(fields: [jobOrderId], references: [id])
  createdById     String?
  createdBy       User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([tenantId])
  @@index([inventoryItemId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// JOB ORDER LIFECYCLE
// ---------------------------------------------------------------------------

// Per-tenant sequence so job numbers are gap-free and serialized, e.g. POMS-ALU-1001
model JobOrderCounter {
  tenantId   String @id
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastNumber Int    @default(1000)

  @@map("job_order_counters")
}

enum JobOrderStatus {
  QUOTATION
  PENDING_DEPOSIT
  IN_PRODUCTION
  READY_FOR_COLLECTION
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum SideOption {
  SINGLE
  DOUBLE
}

model JobOrder {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobNumber     String // e.g. "POMS-ALU-1001"
  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])
  status        JobOrderStatus @default(QUOTATION)
  paymentStatus PaymentStatus  @default(UNPAID)

  subtotal    Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  vatRate     Decimal @default(0) @db.Decimal(5, 2) // percentage, 0 when VAT not applicable
  vatAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @default(0) @db.Decimal(12, 2)
  amountPaid  Decimal @default(0) @db.Decimal(12, 2)
  balanceDue  Decimal @default(0) @db.Decimal(12, 2)

  dueDate   DateTime?
  notes     String?

  createdById  String?
  createdBy    User?     @relation("JobOrderCreatedBy", fields: [createdById], references: [id])
  assignedToId String?
  assignedTo   User?     @relation("JobOrderAssignedTo", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  transactions   Transaction[]
  notifications  Notification[]
  stockMovements StockMovement[]

  @@unique([tenantId, jobNumber])
  @@index([tenantId, status])
  @@index([clientId])
  @@map("job_orders")
}

model OrderItem {
  id                 String            @id @default(cuid())
  jobOrderId         String
  jobOrder           JobOrder          @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  paperTypeId        String?
  paperType          PaperType?        @relation(fields: [paperTypeId], references: [id])
  finishingServiceId String?
  finishingService   FinishingService? @relation(fields: [finishingServiceId], references: [id])
  description        String // free-text label shown on the job sheet / invoice
  sides              SideOption?       // null for finishing-only line items
  quantity           Decimal           @db.Decimal(12, 2)
  unitPrice          Decimal           @db.Decimal(10, 2)
  lineTotal          Decimal           @db.Decimal(12, 2)
  sortOrder          Int               @default(0)

  @@index([jobOrderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// FINANCIALS
// ---------------------------------------------------------------------------

enum TransactionType {
  DEPOSIT
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  MPESA
  BANK
  CARD
  OTHER
}

model Transaction {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobOrderId  String
  jobOrder    JobOrder        @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  method      PaymentMethod   @default(CASH)
  reference   String?
  recordedById String?
  recordedBy  User?           @relation("TransactionRecordedBy", fields: [recordedById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([jobOrderId])
  @@map("transactions")
}

model Purchase {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier     String?
  description  String
  category     String
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod @default(CASH)
  purchaseDate DateTime      @default(now())
  createdById  String?
  createdBy    User?         @relation("PurchaseRecordedBy", fields: [createdById], references: [id])
  createdAt    DateTime      @default(now())

  @@index([tenantId, purchaseDate])
  @@map("purchases")
}

model Expense {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description String
  category    String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(CASH)
  expenseDate DateTime      @default(now())
  createdById String?
  createdBy   User?         @relation("ExpenseRecordedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([tenantId, expenseDate])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS (SMS / WhatsApp gateway log)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationType {
  ORDER_CREATED
  JOB_COMPLETED
  PAYMENT_ACK
  PAYMENT_REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id         String              @id @default(cuid())
  tenantId   String
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobOrderId String?
  jobOrder   JobOrder?           @relation(fields: [jobOrderId], references: [id])
  clientId   String
  client     Client              @relation(fields: [clientId], references: [id])
  channel    NotificationChannel
  type       NotificationType
  message    String
  status     NotificationStatus  @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([tenantId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// STAFF ACTIVITY LOG
// ---------------------------------------------------------------------------

model ActivityLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "JOB_STATUS_CHANGED", "PAYMENT_RECORDED"
  entityType String // e.g. "JobOrder", "Transaction"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("activity_logs")
}
